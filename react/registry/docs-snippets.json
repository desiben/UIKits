    "item-card": "<ItemCard variant=\"secondary\"><ItemCard.Icon>…</ItemCard.Icon><ItemCard.Content><ItemCard.Title>…</ItemCard.Title></ItemCard.Content><ItemCard.Action>…</ItemCard.Action></ItemCard>",
