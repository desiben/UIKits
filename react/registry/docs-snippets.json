    "holo-card": "<HoloCard gradient=\"…\"><HoloCard.Content>…</HoloCard.Content></HoloCard>",
    "map": "<Map center={sf} zoom={12}><Map.Marker coords={hq} /><Map.Route path={route} /></Map>",
    "chat-conversation": "<ChatConversation><ChatConversation.Content>{messages.map(…)}</ChatConversation.Content><ChatConversation.ScrollButton /></ChatConversation>",
    "chat-message": "<ChatMessage role=\"assistant\" variant=\"bubble\"><ChatMessage.Content>…</ChatMessage.Content><ChatMessageActions /></ChatMessage>",
    "chat-message-actions": "<ChatMessageActions onCopy={…} onFeedback={…} onRegenerate={…} />",
    "chain-of-thought": "<ChainOfThought open><ChainOfThought.Step status=\"done\" title=\"Searched CRM\" /></ChainOfThought>",
