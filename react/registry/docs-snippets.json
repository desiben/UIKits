    "segment": "<Segment selectedKey={range} onSelectionChange={setRange}><Segment.Item id=\"week\">Week</Segment.Item></Segment>",
    "navbar": "<Navbar><Navbar.Brand /><Navbar.Content>…</Navbar.Content><Navbar.MenuToggle /><Navbar.Menu>…</Navbar.Menu></Navbar>",
    "app-layout": "<AppLayout sidebar={<Sidebar />} navbar={<Navbar />} aside={<Assistant />} sidebarVariant=\"inset\">{children}</AppLayout>",
    "context-menu": "<ContextMenu><ContextMenu.Trigger>…</ContextMenu.Trigger><ContextMenu.Content>…</ContextMenu.Content></ContextMenu>",
    "emoji-picker": "<EmojiPicker onSelect={(e) => insert(e.emoji)} />",
    "sheet-pro": "<Sheet side=\"right\"><Sheet.Header>…</Sheet.Header><Sheet.Body>…</Sheet.Body><Sheet.Footer>…</Sheet.Footer></Sheet>",
    "button-group": "<ButtonGroup aria-label=\"Message actions\">\n  <Button variant=\"outline\">Archive</Button>\n  <Button variant=\"outline\">Report</Button>\n  <ButtonGroupSeparator />\n  <Button variant=\"outline\" size=\"icon\" aria-label=\"More\"><MoreHorizontal /></Button>\n</ButtonGroup>",
    "input-group": "<InputGroup>\n  <InputGroupAddon><Search /></InputGroupAddon>\n  <InputGroupInput placeholder=\"Search…\" />\n  <InputGroupAddon align=\"inline-end\"><InputGroupButton>Search</InputGroupButton></InputGroupAddon>\n</InputGroup>",
    "label": "<Label htmlFor=\"email\">Email</Label>\n<Input id=\"email\" type=\"email\" />",
    "select": "<Select defaultValue=\"pro\">\n  <SelectTrigger><SelectValue placeholder=\"Select a plan\" /></SelectTrigger>\n  <SelectContent>\n    <SelectGroup><SelectLabel>Plans</SelectLabel><SelectItem value=\"free\">Free</SelectItem><SelectItem value=\"pro\">Pro</SelectItem></SelectGroup>\n  </SelectContent>\n</Select>",
    "combobox": "<Combobox items={frameworks} value={value} onValueChange={setValue}>\n  <ComboboxInput placeholder=\"Select framework…\" />\n  <ComboboxContent><ComboboxEmpty>No framework found.</ComboboxEmpty><ComboboxList>{(item) => <ComboboxItem value={item}>{item.label}</ComboboxItem>}</ComboboxList></ComboboxContent>\n</Combobox>",
    "textarea": "<Textarea placeholder=\"Tell us a little about yourself\" maxLength={160} />",
    "questionnaire": "<Questionnaire onSubmit={(answers) => run(answers)}>\n  <Question id=\"audience\" required title=\"Who is this report for?\">\n    <Option value=\"exec\">Executives</Option><Option value=\"sales\">Sales team</Option><OptionOther />\n  </Question>\n  <Question id=\"include\" multiple title=\"What should I include?\">…</Question>\n  <Question id=\"notes\" freeform title=\"Anything else?\" />\n</Questionnaire>",
    "aspect-ratio": "<AspectRatio ratio={16 / 9}><img src=\"/cover.jpg\" alt=\"Cover\" className=\"object-cover\" /></AspectRatio>",
    "collapsible": "<Collapsible open={open} onOpenChange={setOpen}>\n  <CollapsibleTrigger asChild><Button variant=\"ghost\" size=\"icon\"><ChevronsUpDown /></Button></CollapsibleTrigger>\n  <CollapsibleContent>…</CollapsibleContent>\n</Collapsible>",
    "scroll-area": "<ScrollArea className=\"h-72 w-48 rounded-md border\">…</ScrollArea>",
    "sonner": "import { toast } from \"sonner\"\n<Toaster position=\"bottom-right\" />\ntoast(\"Event created\", { description: \"Sunday at 9:00\", action: { label: \"Undo\", onClick: undo } })\ntoast.promise(save(), { loading: \"Saving…\", success: \"Saved\", error: \"Failed\" })",
    "bubble": "<Bubble align=\"end\" variant=\"primary\">\n  Yes — live since this morning.\n  <BubbleReactions>👍 2</BubbleReactions>\n</Bubble>",
    "marker": "<Marker>Today</Marker>\n<Marker variant=\"status\" icon={<UserPlus />}>Ada joined the conversation</Marker>",
    "message-scroller": "<MessageScroller>\n  <MessageScrollerViewport>{messages.map((m) => <Message key={m.id} turn={m.role === \"user\"} />)}</MessageScrollerViewport>\n  <MessageScrollerJump />\n</MessageScroller>",
    "trace": "<Trace>\n  <TraceItem status=\"done\"><TraceIcon><Search /></TraceIcon><TraceTitle>Searched the web</TraceTitle>\n    <TraceCollapsible>…</TraceCollapsible></TraceItem>\n</Trace>",
    "menubar": "<Menubar>\n  <MenubarMenu><MenubarTrigger>File</MenubarTrigger>\n    <MenubarContent><MenubarItem>New tab <MenubarShortcut>⌘T</MenubarShortcut></MenubarItem></MenubarContent>\n  </MenubarMenu>\n</Menubar>",
    "navigation-menu": "<NavigationMenu>\n  <NavigationMenuList>\n    <NavigationMenuItem><NavigationMenuTrigger>Components</NavigationMenuTrigger>\n      <NavigationMenuContent>…</NavigationMenuContent></NavigationMenuItem>\n  </NavigationMenuList>\n</NavigationMenu>"
  }
