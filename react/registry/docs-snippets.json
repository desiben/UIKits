    "chat-attachment": "<ChatAttachment file={file} progress={64} onRemove={…} />",
    "chat-list-view": "<ChatListView groups={byDate(threads)} selectedKey={id} />",
    "chat-loader": "<ChatLoader variant=\"typing\" />",
    "prompt-input": "<PromptInput onSubmit={send}><PromptInput.Textarea /><PromptInput.Toolbar>…</PromptInput.Toolbar></PromptInput>",
    "prompt-suggestion": "<PromptSuggestion onClick={() => send(text)}>{text}</PromptSuggestion>",
    "code-block": "<CodeBlock language=\"tsx\" filename=\"button.tsx\" highlightLines={[4]}>{code}</CodeBlock>",
    "markdown": "<Markdown>{answer}</Markdown>",
    "text-shimmer": "<TextShimmer>Thinking…</TextShimmer>",
    "trend-chip": "<TrendChip trend=\"up\">12.4%</TrendChip>",
    "number-value": "<NumberValue value={248920} format={{ style: \"currency\", currency: \"USD\" }} />",
    "rating": "<Rating value={4} onChange={setValue} size=\"lg\" />",
    "emoji-reaction": "<EmojiReactionButton emoji=\"👍\" count={12} isSelected onPress={toggle} />",
    "pressable": "<PressableFeedback feedback=\"scale\"><Card>…</Card></PressableFeedback>",
    "resizable": "<ResizablePanelGroup direction=\"horizontal\"><ResizablePanel /><ResizableHandle withHandle /><ResizablePanel /></ResizablePanelGroup>",
    "cell-switch": "<CellSwitch label=\"Read receipts\" description=\"…\" isSelected={on} onChange={setOn} />",
    "cell-select": "<CellSelect label=\"Language\" items={langs} selectedKey={lang} />",
    "cell-slider": "<CellSlider label=\"Volume\" defaultValue={60} formatOptions={{ style: \"percent\" }} />",
    "cell-color-picker": "<CellColorPicker label=\"Accent color\" swatches={presets} value={color} onChange={setColor} />",
    "checkbox-button-group": "<CheckboxButtonGroup label=\"Integrations\" value={picked} onChange={setPicked}>…</CheckboxButtonGroup>",
    "radio-button-group": "<RadioButtonGroup label=\"Plan\" value={plan} onChange={setPlan}>…</RadioButtonGroup>",
    "inline-select": "<InlineSelect items={metrics} selectedKey={metric} aria-label=\"Metric\" />",
    "native-select": "<NativeSelect>…</NativeSelect>",
    "number-stepper": "<NumberStepper minValue={1} maxValue={10} defaultValue={3} />",
