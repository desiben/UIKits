{
  "react": {
    "button": "import { Button } from \"@/components/ui/button\"\n\n<Button>Primary</Button>\n<Button variant=\"outline\" size=\"sm\"><Plus /> New</Button>\n<Button variant=\"destructive\" disabled>Delete</Button>",
    "toggle": "<ToggleGroup type=\"single\" defaultValue=\"list\">\n  <ToggleGroupItem value=\"list\"><List /> List</ToggleGroupItem>\n  <ToggleGroupItem value=\"board\"><Kanban /> Board</ToggleGroupItem>\n</ToggleGroup>",
    "input": "<Input type=\"email\" placeholder=\"you@company.com\" />",
    "field": "<div className=\"grid gap-1.5\">\n  <Label htmlFor=\"name\">Workspace name</Label>\n  <Input id=\"name\" aria-describedby=\"name-help\" />\n  <p id=\"name-help\" className=\"text-sm text-muted-foreground\">Shown in invites.</p>\n</div>",
    "checkbox": "<Checkbox id=\"digest\" defaultChecked />\n<RadioGroup defaultValue=\"monthly\">…</RadioGroup>",
    "switch": "<Switch id=\"sync\" defaultChecked /> <Label htmlFor=\"sync\">Auto-sync</Label>",
    "slider": "<Slider defaultValue={[60]} max={100} />\n<Progress value={75} />",
    "input-otp": "<InputOTP maxLength={6}>\n  <InputOTPGroup><InputOTPSlot index={0} />…</InputOTPGroup>\n</InputOTP>",
    "dropzone": "<Dropzone accept={{\"image/*\": []}} onDrop={upload} />",
    "badge": "<Badge variant=\"success\">Active</Badge>",
    "avatar": "<Avatar><AvatarImage src={url} /><AvatarFallback>MC</AvatarFallback></Avatar>",
    "kbd": "<Kbd>⌘K</Kbd>  <Spinner />  <Skeleton className=\"h-3 w-2/3\" />  <Separator />",
    "card": "<Card>\n  <CardHeader><CardTitle>Northwind renewal</CardTitle><CardDescription>…</CardDescription></CardHeader>\n  <CardContent>…</CardContent>\n  <CardFooter><Button size=\"sm\">Open deal</Button></CardFooter>\n</Card>",
    "table": "const table = useReactTable({ data, columns, getCoreRowModel: getCoreRowModel() })\n<Table>…</Table>  // data-table recipe, styled by Facet tokens",
    "calendar": "<Calendar mode=\"single\" selected={date} onSelect={setDate} />",
    "charts": "// Recharts example\n<Bar dataKey=\"new\" fill=\"var(--chart-1)\" radius={[4, 2, 0, 0]} />",
    "alert": "<Alert variant=\"warning\"><AlertTriangle /><AlertTitle>…</AlertTitle><AlertDescription>…</AlertDescription></Alert>",
    "toast": "import { toast } from \"sonner\"\ntoast(\"Project created\", { description: \"Q4 Launch is ready.\" })",
    "empty-state": "<EmptyState icon={<Folder />} title=\"No projects yet\" action={<Button>New project</Button>} />",
    "dialog": "<Dialog>\n  <DialogTrigger asChild><Button>Invite</Button></DialogTrigger>\n  <DialogContent><DialogHeader><DialogTitle>Invite teammates</DialogTitle></DialogHeader>…</DialogContent>\n</Dialog>",
    "sheet": "<Sheet><SheetTrigger>Open</SheetTrigger><SheetContent side=\"right\">…</SheetContent></Sheet>",
    "dropdown-menu": "<DropdownMenu>\n  <DropdownMenuTrigger asChild><Button variant=\"outline\">Options</Button></DropdownMenuTrigger>\n  <DropdownMenuContent><DropdownMenuItem>Rename</DropdownMenuItem></DropdownMenuContent>\n</DropdownMenu>",
    "popover": "<Tooltip><TooltipTrigger>…</TooltipTrigger><TooltipContent>Copy link</TooltipContent></Tooltip>",
    "accordion": "<Accordion type=\"single\" collapsible><AccordionItem value=\"a\">…</AccordionItem></Accordion>",
    "tabs": "<Tabs defaultValue=\"overview\">\n  <TabsList><TabsTrigger value=\"overview\">Overview</TabsTrigger></TabsList>\n  <TabsContent value=\"overview\">…</TabsContent>\n</Tabs>",
    "breadcrumb": "<Breadcrumb><BreadcrumbList>…</BreadcrumbList></Breadcrumb>\n<Pagination>…</Pagination>",
    "chip": "<Toggle variant=\"chip\" pressed>Enterprise</Toggle>",
    "stepper": "<Stepper current={1} steps={[\"Account\",\"Workspace\",\"Invite team\",\"Connect data\"]} />",
    "sidebar": "<SidebarProvider><Sidebar><SidebarMenuButton isActive>Dashboard</SidebarMenuButton></Sidebar></SidebarProvider>",
