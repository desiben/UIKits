    "bar-chart": "<BarChart data={rows} labels=\"week\" series={[{ key: \"signups\" }]} stacked />",
    "line-chart": "<LineChart data={rows} series={[{ key: \"nrr\", dots: true }, { key: \"target\", dashed: true }]} />",
    "composed-chart": "<ComposedChart data={rows}><Bar dataKey=\"orders\" /><Line dataKey=\"aov\" /></ComposedChart>",
